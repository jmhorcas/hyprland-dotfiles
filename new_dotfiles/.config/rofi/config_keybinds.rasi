/* Main Config - For Keybinds generation */

@import "~/.config/rofi/config.rasi"  

/* ---- Global Properties ---- */
configuration {
    /* Forces Rofi to use a monospaced font so that columns align perfectly */
    font: "JetBrainsMono Nerd Font 11";
}

/* ---- Mainbox ---- */
mainbox {
  children:
    [ "inputbar", "message", "listview"];
}

/* ---- Entry ---- */
entry {
  expand: true;
  placeholder: " 󰌌 Search Keybinds";
}

/* ---- Listview ---- */
listview {
  columns: 1;
  lines: 8;
  fixed-height: false;
  scrollbar: true;
  spacing: 6px;
  cycle: true;
}

window {
  width: 90%;
  height: inherit;
}

/* ---- Elements ---- */
element {
  orientation: horizontal;
}

element-icon {
  	size: 0%;
}

element-text {
    horizontal-align: 0.0;
    vertical-align: 0.5;
    margin: 0px;
    padding: 0px;
}